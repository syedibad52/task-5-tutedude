<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact Form</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <div class="container">
        <h1>Contact Form</h1>
        <p class="subtitle">Docker Full Stack App - Node.js + Flask</p>

        <!-- show success message if form was submitted ok -->
        <% if (response) { %>
        <div class="msg success">
            <strong>Success!</strong> <%= response.message %>
            <br>
            <small>Name: <%= response.data.name %> | Email: <%= response.data.email %></small>
            <br>
            <small>Message: <%= response.data.message %></small>
        </div>
        <% } %>

        <!-- show error if something went wrong -->
        <% if (error) { %>
        <div class="msg error">
            <strong>Error:</strong> <%= error %>
        </div>
        <% } %>

        <form action="/submit" method="POST">
            <div class="form-group">
                <label for="name">Name</label>
                <input type="text" id="name" name="name" placeholder="your name" required>
            </div>

            <div class="form-group">
                <label for="email">Email</label>
                <input type="email" id="email" name="email" placeholder="your email" required>
            </div>

            <div class="form-group">
                <label for="message">Message</label>
                <textarea id="message" name="message" rows="4" placeholder="write something..." required></textarea>
            </div>

            <button type="submit">Submit</button>
        </form>

        <div class="footer">
            <p>Built with Node.js (Express) + Flask | Dockerized with Docker Compose</p>
        </div>
    </div>
</body>
</html>
