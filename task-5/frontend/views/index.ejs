<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact Form - Multi-Container App</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <div class="container">
        <h1>Contact Form</h1>
        <p class="subtitle">Docker Containerized Application (Node.js + Flask)</p>

        <% if (response) { %>
        <div class="msg success">
            <strong>Success!</strong> <%= response.message %>
            <br>
            <small>Name: <%= response.data.name %> | Email: <%= response.data.email %></small>
            <br>
            <small>Message: <%= response.data.message %></small>
        </div>
        <% } %>

        <% if (error) { %>
        <div class="msg error">
            <strong>Error:</strong> <%= error %>
        </div>
        <% } %>

        <form action="/submit" method="POST" id="contact-form">
            <div class="form-group">
                <label for="name">Name</label>
                <input type="text" id="name" name="name" placeholder="Enter your name" required>
            </div>

            <div class="form-group">
                <label for="email">Email</label>
                <input type="email" id="email" name="email" placeholder="Enter your email" required>
            </div>

            <div class="form-group">
                <label for="message">Message</label>
                <textarea id="message" name="message" rows="4" placeholder="Write your message here..." required></textarea>
            </div>

            <button type="submit" id="submit-btn">Submit</button>
        </form>

        <div class="footer">
            <p>Task 5 - Docker Compose Multi-Container Application</p>
        </div>
    </div>
</body>
</html>

